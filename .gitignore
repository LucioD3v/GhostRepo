# GhostRepo — working areas that must NOT be committed to the tool repo

# Local "operating room": cloned legacy targets (includes huge upstream .git histories)
targets/

# Resurrected output lives in its own separate repository
ghostrepo-gaia-calculator/

# Internal workflow artifacts (agent reviews, verdicts) — not part of the tool
.agents/

# Devpost drafts / team docs — not part of the shipped project
_devpost/

# OS / editor noise
.DS_Store
Thumbs.db
*.log
node_modules/
